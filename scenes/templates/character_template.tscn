[ext_resource path="res://scenes/placeholder/tst_objects/tst_waypoint.tscn" type="PackedScene" id=2]

[sub_resource type="GDScript" id=2]
script/source = "extends KinematicBody

# How fast the player moves in meters per second.
export var speed = 14
# The downward acceleration when in the air, in meters per second squared.
export var fall_acceleration = 75

var velocity = Vector3.ZERO

func _physics_process(delta):
	var direction = Vector3.ZERO
	if global_transform.origin.distance_to($waypoint.global_transform.origin) >= 0.1 :
		direction.x = $waypoint.global_transform.origin.x - global_transform.origin.x
		direction.z = $waypoint.global_transform.origin.z - global_transform.origin.z

	if direction != Vector3.ZERO:
		direction = direction.normalized()
		$pivot.look_at(translation + direction, Vector3.UP)

	velocity.x = direction.x * speed
	velocity.z = direction.z * speed
	velocity.y -= fall_acceleration * delta
	velocity = move_and_slide(velocity, Vector3.UP)
"

